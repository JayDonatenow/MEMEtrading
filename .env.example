# Copy this file to .env and fill in what you have. Everything here has a safe
# fallback except DATABASE_URL, so the app runs with mock-free but reduced
# functionality even with nothing else set.

# Postgres connection string. On Vercel, add a Postgres database in the
# project's Storage tab and this is set for you automatically. For local dev,
# point it at any Postgres instance (Vercel Postgres, Neon, Supabase, or a
# local `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres`).
DATABASE_URL="postgresql://user:password@localhost:5432/memetrading"

# Optional: a direct (unpooled) connection string, used only for running
# migrations at build time. On Vercel/Neon, DATABASE_URL is a pooled
# connection that can't hold the migration lock — Vercel sets this
# automatically alongside it (as DATABASE_URL_UNPOOLED), so you shouldn't
# need to set it by hand. Not needed for local dev against a plain Postgres.
# DATABASE_URL_UNPOOLED=""

# Optional: a dedicated Solana RPC endpoint (Helius, QuickNode, Triton, etc).
# The public default is fine for light use but rate-limits aggressively,
# especially for the wallet-clustering checks on the coin detail page.
# SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Optional: X (Twitter) API v2 bearer token (app-only auth), needed for the
# "Relevant tweets" section on a coin's detail page. Without it, that section
# just shows a "not configured" message instead of erroring.
# X_BEARER_TOKEN=""

# Optional: shared secret required in the Authorization header when calling
# POST /api/scan (the watchlist re-scan job meant to be hit by an external
# cron, e.g. Vercel Cron). If unset, the endpoint is unauthenticated — fine
# for local dev, set this before deploying anywhere public.
# CRON_SECRET=""
